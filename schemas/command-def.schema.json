{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "modality": {
      "type": "string",
      "enum": ["text", "files", "args", "none"]
    },
    "args": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "placeholder": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": ["text", "password", "dropdown"]
          },
          "percentEncoded": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": ["title", "value"],
              "additionalProperties": false
            }
          },
          "picker": {
            "type": "string",
            "enum": ["orca-worktree"]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string",
              "enum": ["bash", "node", "applescript"]
            },
            "source": {
              "type": "string"
            }
          },
          "required": ["lang", "source"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lang": {
              "type": "string",
              "const": "exec"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["lang", "executable"],
          "additionalProperties": false
        }
      ]
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "raycast-script",
          "popclip",
          "dropzone",
          "dropover-script",
          "shortcuts-cherri",
          "shortcuts-remote-ssh",
          "termux-shortcut",
          "raycast-snippet",
          "raycast-quicklink",
          "agent-cli"
        ]
      }
    },
    "x": {
      "type": "object",
      "properties": {
        "raycast": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["silent", "fullOutput", "compact", "inline"]
            },
            "packageName": {
              "type": "string"
            },
            "iconDark": {
              "type": "string"
            },
            "needsConfirmation": {
              "type": "boolean"
            },
            "currentDirectoryPath": {
              "type": "string"
            },
            "refreshTime": {
              "type": "string"
            },
            "snippet": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "keyword": {
                  "type": "string"
                }
              },
              "required": ["text"],
              "additionalProperties": false
            },
            "quicklink": {
              "type": "object",
              "properties": {
                "link": {
                  "type": "string"
                },
                "openWith": {
                  "type": "string"
                }
              },
              "required": ["link"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "popclip": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "regex": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dropzone": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Dragged", "Clicked"]
              }
            },
            "handles": {
              "type": "string",
              "enum": ["Files", "Text", "Files, Text"]
            },
            "skipConfig": {
              "type": "boolean"
            },
            "minVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "dropover": {
          "type": "object",
          "properties": {
            "instantAction": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "shortcuts": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "glyph": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "inputs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "installedapp",
                  "app",
                  "article",
                  "contact",
                  "date",
                  "email",
                  "folder",
                  "file",
                  "image",
                  "itunes",
                  "location",
                  "maplink",
                  "media",
                  "pdf",
                  "phonenumber",
                  "richtext",
                  "webpage",
                  "text",
                  "dictionary",
                  "number",
                  "url"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "remote": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": ["profile"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "author": {
      "type": "string"
    }
  },
  "required": ["id", "title", "description", "modality", "body"],
  "additionalProperties": false
}
