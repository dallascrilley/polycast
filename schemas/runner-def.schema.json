{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "runner"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "publisher": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "commands": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "prompt"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "context": {
            "type": "string",
            "const": "worktree"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "mode": {
            "type": "string",
            "enum": ["run", "stage"]
          }
        },
        "required": ["kind", "id", "title", "context", "prompt", "mode"],
        "additionalProperties": false
      }
    },
    "x": {
      "type": "object",
      "properties": {
        "orca-plugin": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^>=\\d+\\.\\d+\\.\\d+$"
            }
          },
          "required": ["engine"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "id", "publisher", "title", "version", "commands"],
  "additionalProperties": false
}
