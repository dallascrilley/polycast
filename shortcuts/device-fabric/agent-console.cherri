#define name Agent Console

#include 'actions/web'

// Tailscale first; the terminal app resolves this fixed saved SSH profile.
rawAction("io.tailscale.ipn.ios.ConnectIntent", {
    "AppIntentDescriptor": {
        "AppIntentIdentifier": "ConnectIntent",
        "BundleIdentifier": "io.tailscale.ipn.ios",
        "TeamIdentifier": "W5364U7YZB",
        "Name": "Tailscale"
    },
    "ShowWhenRun": false
})

openURL("ssh://agent-console")
