#!/usr/bin/env bun
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import packageMetadata from "../package.json" with { type: "json" };
import { POLYCAST_VERSION } from "../src/constants.ts";

const root = resolve(import.meta.dir, "..");

async function read(relativePath: string): Promise<string> {
  return readFile(resolve(root, relativePath), "utf8");
}

function fail(message: string): never {
  console.error(`version consistency failed: ${message}`);
  process.exit(1);
}

const expected = packageMetadata.version;
if (POLYCAST_VERSION !== expected) {
  fail(`runtime reports ${POLYCAST_VERSION}, package.json reports ${expected}`);
}

const mcpSource = await read("src/mcp/server.ts");
if (!mcpSource.includes("version: POLYCAST_VERSION")) {
  fail("MCP server metadata is not wired to POLYCAST_VERSION");
}

const runnerSource = await read("runners/worktree-review.ts");
if (!runnerSource.includes("version: POLYCAST_VERSION")) {
  fail("committed RunnerDef sample is not wired to POLYCAST_VERSION");
}

const agentCliSpec = await read("docs/specs/agent-cli.md");
if (!agentCliSpec.includes('"polycastVersion": "<package version>"')) {
  fail("agent-cli specification does not use the package-version placeholder");
}

const changelog = await read("CHANGELOG.md");
if (!changelog.includes(`## [${expected}]`)) {
  fail(`CHANGELOG.md has no entry for package version ${expected}`);
}

console.log(`version consistency passed: package.json ${expected} -> runtime, MCP, runner sample, docs`);
